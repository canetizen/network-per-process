{
  "title": "Per-Process Network Traffic (eBPF)",
  "uid": "ebpf-process-network",
  "tags": ["ebpf", "network", "process"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "label": "Data source",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "prometheus" },
        "hide": 0
      },
      {
        "type": "query",
        "name": "node",
        "label": "Node",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(ebpf_exporter_process_network_tx_bytes_total, node)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "type": "query",
        "name": "comm",
        "label": "Process",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(ebpf_exporter_process_network_tx_bytes_total{node=~\"$node\"}, comm)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "type": "custom",
        "name": "proto",
        "label": "Protocol",
        "query": "tcp,udp",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "type": "custom",
        "name": "topk",
        "label": "Top N",
        "query": "5,10,20,50",
        "includeAll": false,
        "multi": false,
        "current": { "text": "10", "value": "10" }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "id": 1,
      "title": "Total sent",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "Bps", "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(ebpf_exporter_process_network_tx_bytes_total{node=~\"$node\", comm=~\"$comm\", proto=~\"$proto\"}[$__rate_interval]))",
          "legendFormat": "tx"
        }
      ]
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Total received",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "Bps", "color": { "mode": "fixed", "fixedColor": "green" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(ebpf_exporter_process_network_rx_bytes_total{node=~\"$node\", comm=~\"$comm\", proto=~\"$proto\"}[$__rate_interval]))",
          "legendFormat": "rx"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Traffic by node",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (node) (rate(ebpf_exporter_process_network_tx_bytes_total{node=~\"$node\", comm=~\"$comm\", proto=~\"$proto\"}[$__rate_interval]))",
          "legendFormat": "{{node}} tx"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "-sum by (node) (rate(ebpf_exporter_process_network_rx_bytes_total{node=~\"$node\", comm=~\"$comm\", proto=~\"$proto\"}[$__rate_interval]))",
          "legendFormat": "{{node}} rx"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Top $topk processes — sent",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "fillOpacity": 20, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "topk($topk, sum by (node, comm, pid, cmdline) (rate(ebpf_exporter_process_network_tx_bytes_total{node=~\"$node\", comm=~\"$comm\", proto=~\"$proto\"}[$__rate_interval])))",
          "legendFormat": "{{comm}} [{{pid}}] {{cmdline}} @ {{node}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "Top $topk processes — received",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "fillOpacity": 20, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "topk($topk, sum by (node, comm, pid, cmdline) (rate(ebpf_exporter_process_network_rx_bytes_total{node=~\"$node\", comm=~\"$comm\", proto=~\"$proto\"}[$__rate_interval])))",
          "legendFormat": "{{comm}} [{{pid}}] {{cmdline}} @ {{node}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "Traffic by protocol",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 17 },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "fillOpacity": 20, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (proto) (rate(ebpf_exporter_process_network_tx_bytes_total{node=~\"$node\", comm=~\"$comm\", proto=~\"$proto\"}[$__rate_interval]))",
          "legendFormat": "{{proto}} tx"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (proto) (rate(ebpf_exporter_process_network_rx_bytes_total{node=~\"$node\", comm=~\"$comm\", proto=~\"$proto\"}[$__rate_interval]))",
          "legendFormat": "{{proto}} rx"
        }
      ]
    },
    {
      "type": "table",
      "id": 7,
      "title": "Processes",
      "description": "Current per-process throughput. pid is the thread group id on the node; the same program restarting gets a new pid.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 17 },
      "fieldConfig": {
        "defaults": { "unit": "Bps", "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "pid" },
            "properties": [{ "id": "unit", "value": "none" }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Sent", "desc": true }]
      },
      "targets": [
        {
          "refId": "TX",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (node, comm, pid, cmdline) (rate(ebpf_exporter_process_network_tx_bytes_total{node=~\"$node\", comm=~\"$comm\", proto=~\"$proto\"}[$__rate_interval]))",
          "format": "table",
          "instant": true
        },
        {
          "refId": "RX",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (node, comm, pid, cmdline) (rate(ebpf_exporter_process_network_rx_bytes_total{node=~\"$node\", comm=~\"$comm\", proto=~\"$proto\"}[$__rate_interval]))",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        { "id": "filterFieldsByName", "options": { "include": { "pattern": "node|comm|cmdline|pid|Value.*" } } },
        { "id": "joinByField", "options": { "byField": "pid", "mode": "outer" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "node 2": true, "comm 2": true, "cmdline 2": true },
            "renameByName": {
              "node 1": "Node",
              "comm 1": "Process",
              "cmdline 1": "Command",
              "pid": "PID",
              "Value #TX": "Sent",
              "Value #RX": "Received"
            }
          }
        }
      ]
    }
  ]
}
